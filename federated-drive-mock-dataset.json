      "response": { "code": 0, "message": "OK", "data": { "unlocked": true, "session_token": "share-session-xyz" } }
    },
    {
      "method": "GET",
      "path": "/s/abcDEF12/download",
      "headers_required": { "X-Share-Session": "share-session-xyz" },
      "status": 200,
      "response": { "code": 0, "message": "OK", "data": { "url": "http://cdn.example.com/dl/share/abcDEF12?sig=...", "headers": { "X-Signed": "1" } } }
    },
    {
      "method": "GET",
      "path": "/s/expiredToken/download",
