          "file": { "id": 2, "is_dir": false, "name": "photo-1.jpg", "ext": "jpg", "mime": "image/jpeg", "size": 204800, "disk": "local", "path": "u/1/photo-1.jpg", "hash": "sha256-111", "updated_at": "2025-10-18T11:05:00Z", "parent_id": null },
          "requires_password": true,
          "expires_at": "2025-10-20T12:00:00Z"
        }
      }
    },
    {
      "method": "POST",
      "path": "/s/abcDEF12/unlock",
